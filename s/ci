#!/bin/bash -e

az acr login --name ${AZURE_REGISTRY_NAME}

# Burn in build info (git hash, branch etc) into the image
s/get-build-info > build_info.json

azure_tag="${AZURE_REGISTRY_NAME}.azurecr.io/${AZURE_LIVE_APP_NAME}-django:${GITHUB_SHA}"
docker build --file Dockerfile.production --tag ${azure_tag} .
docker push ${azure_tag}

az containerapp update \
    --name ${AZURE_LIVE_APP_NAME} \
    --resource-group ${AZURE_RESOURCE_GROUP} \
    --image ${azure_tag} \
    --query 'properties.provisioningState'

# Keep the ODS change-detection Container Apps Job on the same image as the
# live app, so the monthly checks always run the code that is in production.
# The job is created once, manually (see
# documentation/docs/developer/ods-change-detection.md); if it does not exist
# yet, skip rather than fail the deploy.
if az containerapp job show \
    --name ods-change-detection \
    --resource-group RCPCH-Dev-AuditTools > /dev/null 2>&1
then
    az containerapp job update \
        --name ods-change-detection \
        --resource-group RCPCH-Dev-AuditTools \
        --image ${azure_tag} \
        --query 'properties.provisioningState'
else
    echo "ODS change-detection job not found - skipping image sync"
fi

# Build the MkDocs static site so the GitHub Pages artifact upload step
# (which expects a `staticdocs` directory at the repo root) has something to upload.

cp envs/example.env envs/.env

docker compose run \
    --env SITE_DIR=documentation/site \
    --env DOCS_URL=https://rcpch.github.io/rcpch-nhs-organisations/ \
    --rm mkdocs \
        mkdocs build --config-file documentation/mkdocs.yml

# Deploy to the docs is handled in the GitHub workflow itself
